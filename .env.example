# Neon PostgreSQL connection string (server-side only)
DATABASE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Optional: set to true only when Neon requires SSL
PGSSL=true
# Optional initial administrator bootstrap token; use once, then remove from Vercel
ADMIN_BOOTSTRAP_TOKEN=
# Optional persistent object storage configuration will be added when a provider is selected.